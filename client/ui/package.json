{
  "name": "rostalk-ui",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "RosTalk desktop UI (React + TypeScript inside the Tauri WebView)",
  "scripts": {
    "dev": "vite",
    "dev:server-setup": "vite --mode server-setup",
    "build": "tsc --noEmit && vite build && vite build --mode server-setup",
    "build:server-setup": "tsc --noEmit && vite build --mode server-setup",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutants": "stryker run",
    "screenshots": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "3.13.12",
    "@tauri-apps/api": "2.12.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "27.2.2",
    "livekit-client": "2.24.1",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
