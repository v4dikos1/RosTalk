# Copy to deploy/dev/.env (Compose loads it automatically) and adjust the IP.
#
# LAN IP of the host that runs Docker Desktop, as seen by the clients:
#   PowerShell: Get-NetIPAddress -AddressFamily IPv4 |
#               Where-Object { $_.IPAddress -notlike '127.*' } |
#               Select-Object -First 1 -ExpandProperty IPAddress
#   cmd:        ipconfig   (IPv4 Address of the active adapter)
#   ip:         ip -4 addr show scope global
#
# Use the address of the adapter that other machines in the LAN can reach.
# 127.0.0.1 does not work for media from the same Windows host (ADR 0001).
# Compose passes this value as both --public-host and --advertise-ip, so the
# invite link and the certificate SAN use the LAN address, never localhost.
ROSTALK_ADVERTISE_IP=192.168.1.10

# Keep false. Loopback ICE candidates break UDP media as soon as node_ip is a
# non-loopback address (ADR 0001).
ROSTALK_LOOPBACK=false
