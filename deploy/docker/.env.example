# Copy to deploy/docker/.env and fill in the two addresses.
#
# Both are normally the public IP of the VPS. On a home Docker host both are
# the LAN IP of the host (see the root README for the Windows dev setup).
ROSTALK_VERSION=dev
ROSTALK_PUBLIC_HOST=
ROSTALK_ADVERTISE_IP=
# Set only with --domain=... in the command section.
ROSTALK_DOMAIN=
